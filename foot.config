[main]
font=Hack:size=11
initial-color-theme=dark
pad=8x8

[environment]

[security]
osc52=copy-enabled

[bell]
system=no
urgent=no
notify=no
visual=no

[scrollback]
lines=10000
multiplier=3.0

[url]
launch=xdg-open ${url}
style=curly

[cursor]
style=block
blink=no

[mouse]
hide-when-typing=yes
alternate-scroll-mode=yes

[touch]

[colors-dark]
background=000000
foreground=ffffff
flash=454545
flash-alpha=0.5

regular0=202020
regular1=d16969
regular2=8aaf68
regular3=d7ba7d
regular4=7aa2c9
regular5=bb9af7
regular6=7dcfff
regular7=d0d0d0

bright0=606060
bright1=e06c75
bright2=98c379
bright3=e5c07b
bright4=82aaff
bright5=c678dd
bright6=56b6c2
bright7=ffffff

selection-foreground=ffffff
selection-background=454545
jump-labels=181818 d7ba7d
scrollback-indicator=181818 7aa2c9
search-box-no-match=ffffff d16969
search-box-match=181818 d7ba7d
urls=7dcfff

[colors-light]

[csd]
preferred=server
size=0
hide-when-maximized=yes
border-width=0

[key-bindings]
clipboard-copy=Control+Shift+c
clipboard-paste=Control+Shift+v
primary-paste=Shift+Insert
search-start=Control+Shift+r
font-increase=Control+plus Control+equal Control+KP_Add
font-decrease=Control+minus Control+KP_Subtract
font-reset=Control+0 Control+KP_0
scrollback-up-page=Shift+Page_Up
scrollback-down-page=Shift+Page_Down

[search-bindings]
cancel=Control+g Control+c Escape
find-prev=Control+r
find-next=Control+s

[url-bindings]
cancel=Control+g Control+c Escape

[text-bindings]

[mouse-bindings]
primary-paste=BTN_MIDDLE